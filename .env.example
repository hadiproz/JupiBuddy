# Copy to .env and fill in. Never commit .env.
# Only API keys are required. Everything else has safe code defaults;
# the commented lines below are optional overrides (leave them commented).

# Meta Model API key (primary brain — Muse Spark). Get the key from the
# Meta Model API console; the $150 hackathon credit applies to this account.
META_API_KEY=
# Baseten API key (Muse Spark Open via Baseten Model APIs). Optional;
# required only for the Baseten provider.
BASETEN_API_KEY=

# --- Optional overrides (leave commented unless you know you need them) ---
# Gateways (uncomment to pin):
# META_BASE_URL=https://api.meta.ai/v1
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# Custom provider (all three required when provider=Custom):
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=
